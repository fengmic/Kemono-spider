<Window x:Class="KemonoDownloader.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:helpers="clr-namespace:KemonoDownloader.Wpf.Helpers"
        mc:Ignorable="d"
        Title="Kemono 下载器"
        Icon="Assets/app-icon.png"
        Width="1160" Height="800"
        MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="6" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Width="28" Height="28" Source="Assets/app-icon.png" />
                    <TextBlock Text="KEMONO 下载器" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Border Background="#20342E" CornerRadius="3" Padding="7,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v4.7.2" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="&#xE921;" ToolTip="最小化" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="MaximizeButton" Content="&#xE922;" ToolTip="最大化" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="&#xE8BB;" ToolTip="关闭" Style="{StaticResource CloseCaptionButtonStyle}" Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="工作区" Style="{StaticResource MutedTextStyle}" FontSize="11" FontWeight="SemiBold" Margin="22,22,0,10" />
                    <ListBox Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Style="{StaticResource NavigationListStyle}">
                        <ListBoxItem Style="{StaticResource NavigationItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Width="24" />
                                <TextBlock Text="作者集合" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource NavigationItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Width="24" />
                                <TextBlock Text="单作品" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource NavigationItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Width="24" />
                                <TextBlock Text="断点续传" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource NavigationItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Width="24" />
                                <TextBlock Text="设置" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource NavigationItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE90F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Width="24" />
                                <TextBlock Text="补足与修复" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                    <Border Grid.Row="2" Margin="14,0,14,16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="本地模式" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" />
                            </StackPanel>
                            <TextBlock Text=".NET 10 · win-x64" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="14,5,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="62" />
                    <RowDefinition Height="218" />
                </Grid.RowDefinitions>

                <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Style="{StaticResource WorkspaceTabControlStyle}">
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="28,22,28,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="作者集合下载" Style="{StaticResource PageTitleStyle}" />
                                <Grid Grid.Row="1" Margin="0,24,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="服务器" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding Settings.Domains}" SelectedItem="{Binding Author.Domain, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="服务平台" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding Author.Services}" SelectedItem="{Binding Author.Service}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="作者 ID" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Author.Username, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="2" Margin="0,18,0,0">
                                    <TextBlock Text="保存路径" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Author.SavePath}" IsReadOnly="True" />
                                        <Button Grid.Column="1" Content="&#xE8B7;" ToolTip="选择保存文件夹" Style="{StaticResource IconButtonStyle}" Command="{Binding SelectAuthorPathCommand}" Margin="8,0,0,0" />
                                    </Grid>
                                </StackPanel>
                                <Grid Grid.Row="3" Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="限制数量" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Author.Limit, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="并发下载数" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Author.Concurrent, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Grid.Row="4" Margin="0,18,0,0">
                                    <CheckBox Content="跳过已存在文件" IsChecked="{Binding Author.SkipExisting}" Margin="0,0,22,0" />
                                    <CheckBox Content="下载缩略图版本" IsChecked="{Binding Author.UseThumbnail}" Margin="0,0,22,0" />
                                    <CheckBox Content="全新进度" IsChecked="{Binding Author.ForceFresh}" />
                                </WrapPanel>
                                <WrapPanel Grid.Row="5" Margin="0,18,0,0">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddAuthorToQueueCommand}" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><TextBlock Text="添加到队列" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel>
                                    </Button>
                                    <Button Content="继续队列" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResumeAuthorQueueCommand}" Visibility="{Binding IsAuthorQueuePaused, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </WrapPanel>
                                <Border Grid.Row="6" Style="{StaticResource PanelBorderStyle}" Margin="0,18,0,0" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="作者任务队列" FontWeight="SemiBold" />
                                                <Border Background="#20342E" CornerRadius="3" Padding="7,3" Margin="9,0,0,0"><TextBlock Text="{Binding AuthorQueue.Count}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" /></Border>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="清除已结束" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearFinishedAuthorQueueItemsCommand}" MinHeight="30" Padding="10,5" />
                                        </Grid>
                                        <ScrollViewer Grid.Row="1" MaxHeight="190" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                            <ItemsControl ItemsSource="{Binding AuthorQueue}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="4,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding AuthorName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="12,0,0,0" />
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding IdentityDetail}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" />
                                                                    <TextBlock Text="{Binding CurrentItem}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Margin="0,7,0,0" />
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="&#xE74D;" ToolTip="移除等待中的任务" Style="{StaticResource IconButtonStyle}" Width="30" MinWidth="30" Height="30" MinHeight="30" Margin="12,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding IsPending}" Command="{Binding DataContext.RemoveAuthorQueueItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="28,22,28,20">
                                <TextBlock Text="单作品下载" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="作品链接" Style="{StaticResource FieldLabelStyle}" Margin="0,24,0,7" />
                                <TextBox Text="{Binding SinglePost.PostUrl, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="保存路径" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,7" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SinglePost.SavePath}" IsReadOnly="True" />
                                    <Button Grid.Column="1" Content="&#xE8B7;" ToolTip="选择保存文件夹" Style="{StaticResource IconButtonStyle}" Command="{Binding SelectSinglePostPathCommand}" Margin="8,0,0,0" />
                                </Grid>
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="并发下载数" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding SinglePost.Concurrent, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" Margin="24,25,0,0" VerticalAlignment="Center">
                                        <CheckBox Content="跳过已存在文件" IsChecked="{Binding SinglePost.SkipExisting}" Margin="0,0,22,0" />
                                        <CheckBox Content="下载缩略图版本" IsChecked="{Binding SinglePost.UseThumbnail}" Margin="0,0,22,0" />
                                        <CheckBox Content="全新进度" IsChecked="{Binding SinglePost.ForceFresh}" />
                                    </WrapPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28,22,28,20">
                            <TextBlock Text="断点续传" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="进度目录" Style="{StaticResource FieldLabelStyle}" Margin="0,24,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Resume.BasePath}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="&#xE8B7;" ToolTip="选择进度目录" Style="{StaticResource IconButtonStyle}" Command="{Binding SelectResumePathCommand}" Margin="8,0,0,0" />
                            </Grid>
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="0,18,0,0" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" Background="#1F3545" CornerRadius="4">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource BlueBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="任务信息" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Resume.TaskInfo}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <CheckBox Content="重置进度记录后重新检查本地文件" IsChecked="{Binding Resume.ResetProgress}" Margin="0,16,0,0" />
                        </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="28,22,28,20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel Grid.ColumnSpan="3">
                                    <TextBlock Text="服务器域名" Style="{StaticResource PageTitleStyle}" />
                                    <Grid Margin="0,24,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="当前服务器" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox ItemsSource="{Binding Settings.Domains}" SelectedItem="{Binding Settings.SelectedDomain, Mode=TwoWay}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="&#xE74D;" ToolTip="删除选中的自定义域名" Style="{StaticResource IconButtonStyle}" Command="{Binding RemoveDomainCommand}" IsEnabled="{Binding Settings.CanRemoveSelectedDomain}" Margin="8,25,0,0" />
                                    </Grid>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="添加自定义域名" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding Settings.NewDomain, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="添加域名" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddDomainCommand}" Margin="10,25,0,0" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,30,0,0">
                                    <TextBlock Text="下载设置" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="HTTP 请求最大尝试次数" Style="{StaticResource FieldLabelStyle}" Margin="0,24,0,7" /><TextBox Text="{Binding Settings.Retries, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="图片/普通附件无数据超时（秒）" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,7" /><TextBox Text="{Binding Settings.ImageTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="视频无数据超时（秒）" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,7" /><TextBox Text="{Binding Settings.VideoTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="页面请求间隔（毫秒）" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,7" /><TextBox Text="{Binding Settings.PageRequestDelayMs, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="默认并发数" Style="{StaticResource FieldLabelStyle}" /><TextBox Text="{Binding Settings.DefaultConcurrent, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="作品入队间隔（毫秒）" Style="{StaticResource FieldLabelStyle}" /><TextBox Text="{Binding Settings.BatchDelayMs, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    </Grid>
                                    <CheckBox Content="默认跳过已存在文件" IsChecked="{Binding Settings.SkipExistingDefault}" Margin="0,15,0,0" />
                                    <Expander Header="高级下载超时" Style="{StaticResource AdvancedExpanderStyle}" Margin="0,18,0,0">
                                        <StackPanel>
                                            <TextBlock Text="响应头超时（秒）" Style="{StaticResource FieldLabelStyle}" /><TextBox Text="{Binding Settings.DownloadHeaderTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="最低持续速度（KiB/s）" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,7" /><TextBox Text="{Binding Settings.DownloadMinimumSpeedKibPerSecond, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="低速判断窗口（秒）" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,7" /><TextBox Text="{Binding Settings.DownloadLowSpeedWindowSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="最大总时长（小时）" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,7" /><TextBox Text="{Binding Settings.DownloadMaxTotalHours, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,30,0,0">
                                    <TextBlock Text="代理设置" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="代理类型" Style="{StaticResource FieldLabelStyle}" Margin="0,24,0,7" /><ComboBox ItemsSource="{Binding Settings.ProxyTypes}" SelectedItem="{Binding Settings.ProxyType}" />
                                    <TextBlock Text="代理主机" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,7" /><TextBox Text="{Binding Settings.ProxyHost, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="代理端口" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,7" /><TextBox Text="{Binding Settings.ProxyPort, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="代理用户名" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,7" /><TextBox Text="{Binding Settings.ProxyUsername, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="代理密码" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,7" /><PasswordBox helpers:PasswordBoxAssistant.BoundPassword="{Binding Settings.ProxyPassword, Mode=TwoWay}" />
                                    <WrapPanel Margin="0,18,0,0">
                                        <Button Content="保存设置" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveSettingsCommand}" Margin="0,0,10,0" />
                                        <Button Content="恢复默认" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResetSettingsCommand}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Settings.StatusMessage}" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28,22,28,20">
                            <TextBlock Text="缺失补足与文件修复" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="扫描模式" Style="{StaticResource FieldLabelStyle}" Margin="0,24,0,7" />
                            <ComboBox ItemsSource="{Binding Repair.Modes}" SelectedItem="{Binding Repair.SelectedMode, Mode=TwoWay}" Width="240" HorizontalAlignment="Left" />
                            <CheckBox Content="批量处理上一级目录" IsChecked="{Binding Repair.IsBatchMode}" Margin="0,16,0,0" />
                            <TextBlock Text="{Binding Repair.PathLabel}" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Repair.BasePath}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="&#xE8B7;" ToolTip="选择作者目录" Style="{StaticResource IconButtonStyle}" Command="{Binding SelectRepairPathCommand}" Margin="8,0,0,0" />
                            </Grid>
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Repair.IsMissingMode}" Value="True"><Setter Property="IsEnabled" Value="False" /><Setter Property="Opacity" Value="0.45" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <TextBlock Text="损坏阈值（KB）" Style="{StaticResource FieldLabelStyle}" /><TextBox Text="{Binding Repair.FileSizeLimitKb, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="修复并发数" Style="{StaticResource FieldLabelStyle}" /><TextBox Text="{Binding Repair.Concurrent, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            </Grid>
                            <CheckBox Content="使用缩略图补足" IsChecked="{Binding Repair.UseThumbnail}" IsEnabled="{Binding Repair.IsMissingMode}" Margin="0,16,0,0" />
                            <WrapPanel Margin="0,18,0,0">
                                <Button Content="{Binding Repair.ScanButtonText}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ScanRepairCommand}" Margin="0,0,10,0" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ViewMissingFilesCommand}" Margin="0,0,10,0" Visibility="{Binding Repair.CanViewMissingFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="查看缺失文件" /></StackPanel>
                                </Button>
                                <Button Content="{Binding Repair.RepairButtonText}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RepairFilesCommand}" />
                            </WrapPanel>
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="0,18,0,0" Padding="14">
                                <TextBlock Text="{Binding Repair.ResultText}" Style="{StaticResource MutedTextStyle}" />
                            </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding Task.StatusText}" Margin="8,0,0,0" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Task.CurrentItem}" Style="{StaticResource MutedTextStyle}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartCommand}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="开始下载" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource DangerButtonStyle}" Command="{Binding StopCommand}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="停止" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="20,16,20,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PanelBorderStyle}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="当前任务" FontWeight="SemiBold" />
                                <Border Grid.Column="1" Background="#20342E" CornerRadius="3" Padding="7,3"><TextBlock Text="{Binding Task.StatusText}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" /></Border>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding Task.Title}" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,0" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Row="2" Margin="0,10,0,0" Background="#20342E" CornerRadius="3" Padding="8,5" Visibility="{Binding Task.IsIncremental, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding Task.IncrementalText}" Foreground="{StaticResource AccentBrush}" FontSize="11" /></Border>
                            <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                                <ProgressBar Value="{Binding Task.ProgressPercent}" Maximum="100" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MutedTextStyle}"><Run Text="已完成文件 " /><Run Text="{Binding Task.DownloadedFiles}" /></TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Task.ProgressPercent, StringFormat={}{0:F0}%}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Margin="14,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource BlueBrush}" Margin="0,0,8,0" /><TextBlock Text="系统日志" FontWeight="SemiBold" /></StackPanel>
                                <Button Grid.Column="1" Content="&#xE74D;" ToolTip="清空日志" Style="{StaticResource IconButtonStyle}" Width="30" Height="30" MinHeight="30" Command="{Binding ClearLogsCommand}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0" Padding="10,7" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="False">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Focusable" Value="False" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText, Mode=OneWay}" Margin="3,2" FontFamily="Cascadia Mono, Consolas" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="Success"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Warning"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Error"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
